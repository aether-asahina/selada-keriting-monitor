-            // Note: In browser context, CV image segmentation is executed via scripts/scheduler_daemon.py
-            const now = Date.now();
-            return {
-                image_id: `cap_${now}`,
-                plant_id: CAMPAIGN_SPEC.defaultPlantId,
-                captured_at: now,
-                time_wib: this.formatWIBTime(now),
