+/* Selada Keriting Monitor · gaya tunggal (terang/gelap otomatis mengikuti sistem) */
+:root {
+    --bg: #f4f7f4;
+    --card: #ffffff;
+    --ink: #15231b;
+    --muted: #5b6b61;
+    --line: #e1e8e2;
+    --accent: #2c8a4b;
+    --accent-ink: #ffffff;
+    --blue: #2b6cb0;
+    --amber: #a8681a;
+    --rose: #c0392b;
+    --soft: #eef3ee;
+    --ok-bg: #e2f3e7;  --ok-fg: #1f6b3a;
+    --warn-bg: #fbefd6; --warn-fg: #8a5a12;
+    --err-bg: #fbe3e0; --err-fg: #a02f24;
+    --info-bg: #e2edf9; --info-fg: #24598f;
+    --mute-bg: #eceeed; --mute-fg: #56635b;
+    --radius: 14px;
+    --nav-w: 232px;
+    --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+    --mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
+}
+
+@media (prefers-color-scheme: dark) {
+    :root {
+        --bg: #0f1612;
+        --card: #17211b;
+        --ink: #e6efe8;
+        --muted: #93a39a;
+        --line: #26332b;
+        --accent: #4cb06c;
+        --accent-ink: #0b140e;
+        --blue: #6aa8e8;
+        --amber: #e0a24d;
+        --rose: #ec7b6f;
+        --soft: #1d2923;
+        --ok-bg: #1b3a26;  --ok-fg: #7fd69b;
+        --warn-bg: #3d2f14; --warn-fg: #e7b865;
+        --err-bg: #432320; --err-fg: #f1928a;
+        --info-bg: #1c3250; --info-fg: #8bbcf0;
+        --mute-bg: #232d27; --mute-fg: #9aaaa0;
+    }
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; }
+body {
+    margin: 0;
+    background: var(--bg);
+    color: var(--ink);
+    font-family: var(--font);
+    font-size: 14px;
+    line-height: 1.5;
+    overflow-x: hidden;
+}
+h1, h2, p { margin: 0; }
+button, input, select { font: inherit; color: inherit; }
+[hidden] { display: none !important; }
+
+/* ---------- Layout ---------- */
+.app { min-height: 100vh; }
+.main {
+    min-width: 0;
+    padding: 16px 16px calc(84px + env(safe-area-inset-bottom));
+    max-width: 1120px;
+    margin: 0 auto;
+}
+
+.nav {
+    position: fixed;
+    left: 0; right: 0; bottom: 0;
+    z-index: 20;
+    display: flex;
+    background: var(--card);
+    border-top: 1px solid var(--line);
+    padding-bottom: env(safe-area-inset-bottom);
+}
+.nav-brand { display: none; }
+.nav-link {
+    flex: 1 1 0;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 2px;
+    padding: 9px 2px 8px;
+    color: var(--muted);
+    text-decoration: none;
+    font-size: 11px;
+    font-weight: 500;
+    text-align: center;
+}
+.nav-link svg { width: 22px; height: 22px; }
+.nav-link span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.nav-link.active { color: var(--accent); font-weight: 600; }
+
+@media (min-width: 900px) {
+    .app { display: grid; grid-template-columns: var(--nav-w) minmax(0, 1fr); }
+    .main { padding: 24px 28px 40px; width: 100%; }
+    .nav {
+        position: sticky;
+        top: 0;
+        height: 100vh;
+        flex-direction: column;
+        gap: 4px;
+        padding: 18px 12px;
+        border-top: 0;
+        border-right: 1px solid var(--line);
+    }
+    .nav-brand { display: flex; align-items: center; gap: 10px; padding: 4px 8px 18px; }
+    .nav-logo {
+        width: 36px; height: 36px; border-radius: 10px;
+        display: grid; place-items: center;
+        background: var(--accent); color: var(--accent-ink);
+    }
+    .nav-logo svg { width: 20px; height: 20px; }
+    .nav-brand-text { display: flex; flex-direction: column; line-height: 1.2; }
+    .nav-brand-text small { color: var(--muted); font-size: 12px; }
+    .nav-link {
+        flex: 0 0 auto;
+        flex-direction: row;
+        justify-content: flex-start;
+        gap: 12px;
+        padding: 10px 12px;
+        border-radius: 10px;
+        font-size: 14px;
+        text-align: left;
+    }
+    .nav-link:hover { background: var(--soft); }
+    .nav-link.active { background: var(--ok-bg); color: var(--ok-fg); }
+}
+
+/* ---------- Topbar ---------- */
+.topbar {
+    display: flex;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 12px;
+    margin-bottom: 16px;
+}
+.topbar-text { min-width: 0; }
+.topbar h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; }
+.topbar p { color: var(--muted); font-size: 13px; margin-top: 2px; }
+.topbar .badge { flex: 0 0 auto; margin-top: 4px; }
+
+/* ---------- Komponen ---------- */
+.badge {
+    display: inline-block;
+    padding: 3px 10px;
+    border-radius: 999px;
+    font-size: 11px;
+    font-weight: 600;
+    white-space: nowrap;
+    width: fit-content;
+}
+.badge.ok { background: var(--ok-bg); color: var(--ok-fg); }
+.badge.warn { background: var(--warn-bg); color: var(--warn-fg); }
+.badge.err { background: var(--err-bg); color: var(--err-fg); }
+.badge.info { background: var(--info-bg); color: var(--info-fg); }
+.badge.muted { background: var(--mute-bg); color: var(--mute-fg); }
+
+.card {
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    padding: 16px;
+    margin-bottom: 16px;
+    min-width: 0;
+}
+.card-head {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 10px 16px;
+    margin-bottom: 12px;
+}
+.card-head > div:first-child { min-width: 0; flex: 1 1 220px; }
+.card h2 { font-size: 15px; font-weight: 650; }
+.hint { color: var(--muted); font-size: 12.5px; margin-top: 2px; }
+.card > .hint { margin-top: 10px; }
+.controls { display: flex; flex-wrap: wrap; gap: 8px; max-width: 100%; }
+
+.btn {
+    border: 1px solid var(--line);
+    background: var(--card);
+    padding: 8px 14px;
+    border-radius: 10px;
+    cursor: pointer;
+    font-weight: 600;
+    font-size: 13px;
+    min-height: 38px;
+}
+.btn:hover { background: var(--soft); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
+.btn.primary:hover { filter: brightness(1.06); }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.seg {
+    display: inline-flex;
+    max-width: 100%;
+    border: 1px solid var(--line);
+    border-radius: 10px;
+    overflow: hidden;
+    background: var(--soft);
+}
+.seg button {
+    border: 0;
+    background: transparent;
+    padding: 7px 12px;
+    cursor: pointer;
+    font-size: 12.5px;
+    font-weight: 600;
+    color: var(--muted);
+    min-height: 36px;
+}
+.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
+
+input[type="text"], select {
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: 10px;
+    padding: 8px 12px;
+    min-height: 38px;
+    max-width: 100%;
+}
+.field-row { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
+.field-row input { flex: 1 1 180px; min-width: 0; }
+
+/* ---------- KPI ---------- */
+.kpi-grid {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 12px;
+    margin-bottom: 16px;
+}
+.kpi {
+    background: var(--card);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    padding: 14px;
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+    min-width: 0;
+}
+.kpi:last-child { grid-column: 1 / -1; }
+.kpi-label { color: var(--muted); font-size: 12px; font-weight: 600; }
+.kpi-value { display: flex; align-items: baseline; gap: 4px; }
+.kpi-value b { font-size: 26px; font-weight: 700; font-family: var(--mono); letter-spacing: -0.02em; }
+.kpi-value small { color: var(--muted); font-size: 13px; }
+.kpi-sub { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
+
+@media (min-width: 640px) {
+    .kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+    .kpi:last-child { grid-column: auto; }
+}
+@media (min-width: 1000px) {
+    .kpi-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+}
+
+/* ---------- Grafik ---------- */
+.chart { width: 100%; height: 220px; position: relative; }
+.chart svg { display: block; width: 100%; height: 100%; touch-action: pan-y; }
+.chart .empty {
+    height: 100%;
+    display: grid;
+    place-items: center;
+    text-align: center;
+    padding: 0 16px;
+    color: var(--muted);
+    border: 1px dashed var(--line);
+    border-radius: 10px;
+    font-size: 13px;
+}
+.chart .grid { stroke: var(--line); stroke-width: 1; }
+.chart .axis { fill: var(--muted); font-size: 10.5px; font-family: var(--mono); }
+.chart .cross { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3; }
+.readout {
+    min-height: 20px;
+    margin-top: 8px;
+    color: var(--muted);
+    font-size: 12.5px;
+    font-family: var(--mono);
+    overflow-wrap: anywhere;
+}
+
+/* ---------- Tabel ---------- */
+.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
+table { width: 100%; border-collapse: collapse; min-width: 460px; }
+th, td { padding: 9px 10px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
+th { color: var(--muted); font-size: 12px; font-weight: 600; }
+td { font-size: 13px; font-family: var(--mono); }
+@media (max-width: 640px) {
+    table { min-width: 0; }
+    th, td { padding: 8px 5px; font-size: 12px; }
+}
+td.empty-row { text-align: center; color: var(--muted); font-family: var(--font); padding: 22px 10px; }
+
+/* ---------- Kamera & CNN ---------- */
+.split { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
+.split > .card { margin-bottom: 0; }
+@media (min-width: 900px) { .split { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }
+.split + .card { margin-top: 16px; }
+
+.cam-view {
+    position: relative;
+    margin-top: 10px;
+    aspect-ratio: 4 / 3;
+    background: #0d130f;
+    border-radius: 10px;
+    overflow: hidden;
+    display: grid;
+    place-items: center;
+}
+.cam-view img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
+.cam-msg { color: #9db0a4; font-size: 13px; text-align: center; padding: 0 20px; }
+
+.class-list { display: grid; gap: 12px; }
+.class-row { display: grid; gap: 4px; }
+.class-top { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; }
+.class-top b { font-family: var(--mono); }
+.bar { height: 8px; border-radius: 999px; background: var(--soft); overflow: hidden; }
+.bar span { display: block; height: 100%; border-radius: 999px; background: var(--accent); }
+.bar span.info { background: var(--blue); }
+.bar span.warn { background: var(--amber); }
+.bar span.err { background: var(--rose); }
+
+.gallery { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
+@media (min-width: 640px) { .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+@media (min-width: 1000px) { .gallery { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+.shot {
+    display: block;
+    border: 1px solid var(--line);
+    border-radius: 10px;
+    overflow: hidden;
+    text-decoration: none;
+    color: inherit;
+    background: var(--soft);
+    min-width: 0;
+}
+.shot-img { aspect-ratio: 4 / 3; background: var(--mute-bg); display: grid; place-items: center; color: var(--muted); font-size: 12px; }
+.shot-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.shot-meta { padding: 8px 10px; display: grid; gap: 4px; font-size: 12px; }
+.shot-meta b { font-family: var(--mono); font-size: 13px; }
+.gallery-empty { grid-column: 1 / -1; padding: 24px 0; text-align: center; color: var(--muted); }
+
+/* ---------- Prediksi ---------- */
+.progress { display: grid; gap: 6px; margin-bottom: 14px; }
+.progress-bar { height: 8px; border-radius: 999px; background: var(--soft); overflow: hidden; }
+.progress-bar span { display: block; height: 100%; background: var(--accent); transition: width 0.3s; }
+.forecast-grid { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 14px; }
+@media (min-width: 640px) { .forecast-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+.fc {
+    border: 1px solid var(--line);
+    border-radius: 12px;
+    padding: 12px;
+    display: grid;
+    gap: 4px;
+    background: var(--soft);
+    min-width: 0;
+}
+.fc small { color: var(--muted); font-size: 12px; }
+.fc b { font-size: 20px; font-family: var(--mono); }
+
+/* ---------- AI ---------- */
+.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
+.chip {
+    border: 1px solid var(--line);
+    background: var(--soft);
+    border-radius: 999px;
+    padding: 6px 12px;
+    font-size: 12.5px;
+    cursor: pointer;
+}
+.chip:hover { background: var(--ok-bg); }
+.thread {
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    max-height: 46vh;
+    min-height: 160px;
+    overflow-y: auto;
+    padding: 4px 2px 12px;
+}
+.bubble { max-width: 88%; display: grid; gap: 3px; }
+.bubble.user { align-self: flex-end; }
+.bubble-body { padding: 10px 12px; border-radius: 12px; background: var(--soft); overflow-wrap: anywhere; }
+.bubble.user .bubble-body { background: var(--accent); color: var(--accent-ink); }
+.bubble-meta { font-size: 11px; color: var(--muted); }
+.bubble.user .bubble-meta { text-align: right; }
+
+/* ---------- Toast ---------- */
+.toast {
+    position: fixed;
+    left: 50%;
+    bottom: calc(92px + env(safe-area-inset-bottom));
+    transform: translateX(-50%);
+    z-index: 40;
+    background: var(--ink);
+    color: var(--bg);
+    padding: 10px 16px;
+    border-radius: 10px;
+    font-size: 13px;
+    max-width: calc(100vw - 32px);
+}
+@media (min-width: 900px) { .toast { bottom: 28px; } }
