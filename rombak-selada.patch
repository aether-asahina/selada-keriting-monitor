diff --git a/js/forecast.js b/js/forecast.js
new file mode 100644
index 0000000..a089b35
--- /dev/null
+++ b/js/forecast.js
@@ -0,0 +1,111 @@
+/**
+ * Forecast: prediksi 4 hari ke depan dengan LSTM (TensorFlow.js, dilatih di browser).
+ * Masukan = deret harian lebar daun REAL (+ tahap tumbuh dari kelas CNN bila semua hari punya kelas).
+ * Hasil prediksi hanya boleh ditampilkan di bagian Prediksi LSTM.
+ */
+(function (window) {
+    'use strict';
+
+    const TF_URL = 'https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.min.js';
+    const MIN_DAYS = 8;   // minimal hari data nyata
+    const WINDOW = 3;     // panjang jendela LSTM (hari)
+    const HORIZON = 4;    // hari ke depan
+    const DAY_MS = 86400000;
+
+    let tfPromise = null;
+    function loadTF() {
+        if (window.tf) return Promise.resolve(window.tf);
+        if (!tfPromise) {
+            tfPromise = new Promise((resolve, reject) => {
+                const s = document.createElement('script');
+                s.src = TF_URL;
+                s.async = true;
+                s.onload = () => (window.tf ? resolve(window.tf) : reject(new Error('TensorFlow.js gagal dimuat')));
+                s.onerror = () => {
+                    tfPromise = null;
+                    reject(new Error('Tidak dapat memuat TensorFlow.js. Periksa koneksi internet.'));
+                };
+                document.head.appendChild(s);
+            });
+        }
+        return tfPromise;
+    }
+
+    /** Isi hari yang bolong dengan interpolasi linear agar deret harian utuh. */
+    function fillGaps(daily) {
+        const out = [];
+        for (let i = 0; i < daily.length; i++) {
+            const cur = daily[i];
+            if (i > 0) {
+                const prev = daily[i - 1];
+                const gap = Math.round((cur.t - prev.t) / DAY_MS) - 1;
+                for (let g = 1; g <= gap; g++) {
+                    const f = g / (gap + 1);
+                    out.push({
+                        t: prev.t + g * DAY_MS,
+                        width: prev.width + (cur.width - prev.width) * f,
+                        stage: prev.stage !== null && cur.stage !== null ? prev.stage + (cur.stage - prev.stage) * f : null,
+                        interpolated: true
+                    });
+                }
+            }
+            out.push({ t: cur.t, width: cur.width, stage: cur.stage, interpolated: false });
+        }
+        return out;
+    }
+
+    async function run(daily) {
+        if (!Array.isArray(daily) || daily.length < MIN_DAYS) {
+            return { ok: false, have: daily ? daily.length : 0, need: MIN_DAYS };
+        }
+        const days = fillGaps(daily);
+        const useStage = days.every(d => d.stage !== null);
+        const maxW = Math.max.apply(null, days.map(d => d.width)) * 1.25 || 1;
+        const seq = days.map(d => (useStage ? [d.width / maxW, d.stage / 2] : [d.width / maxW]));
+        const F = useStage ? 2 : 1;
+
+        const xs = [];
+        const ys = [];
+        for (let i = 0; i + WINDOW < seq.length; i++) {
+            xs.push(seq.slice(i, i + WINDOW));
+            ys.push(seq[i + WINDOW]);
+        }
+
+        const tf = await loadTF();
+        const X = tf.tensor3d(xs);
+        const Y = tf.tensor2d(ys);
+        const model = tf.sequential();
+        model.add(tf.layers.lstm({ units: 16, inputShape: [WINDOW, F] }));
+        model.add(tf.layers.dense({ units: F }));
+        model.compile({ optimizer: tf.train.adam(0.01), loss: 'meanSquaredError' });
+
+        try {
+            const hist = await model.fit(X, Y, { epochs: 200, batchSize: Math.min(8, xs.length), shuffle: true, verbose: 0 });
+            const loss = hist.history.loss[hist.history.loss.length - 1];
+
+            let win = seq.slice(-WINDOW);
+            const last = days[days.length - 1];
+            const forecast = [];
+            for (let k = 1; k <= HORIZON; k++) {
+                const input = tf.tensor3d([win]);
+                const output = model.predict(input);
+                const next = Array.from(output.dataSync());
+                input.dispose();
+                output.dispose();
+                win = win.slice(1).concat([next]);
+                forecast.push({
+                    t: last.t + k * DAY_MS,
+                    width: Math.max(0, next[0]) * maxW,
+                    stage: useStage ? Math.round(Math.max(0, Math.min(2, next[1] * 2))) : null
+                });
+            }
+            return { ok: true, history: days, forecast: forecast, loss: loss, samples: xs.length, useStage: useStage };
+        } finally {
+            X.dispose();
+            Y.dispose();
+            model.dispose();
+        }
+    }
+
+    window.Forecast = { MIN_DAYS: MIN_DAYS, WINDOW: WINDOW, HORIZON: HORIZON, run: run, fillGaps: fillGaps };
+})(window);
diff --git a/js/growth.js b/js/growth.js
new file mode 100644
index 0000000..ac65e51
--- /dev/null
+++ b/js/growth.js
@@ -0,0 +1,153 @@
+/**
+ * GrowthStore: data lebar daun REAL hasil pipeline CV (data/growth_metadata.json).
+ * Hanya lebar daun yang dipakai. Kelas CNN (cnn_class) diisi pipeline setelah model dilatih.
+ */
+(function (window) {
+    'use strict';
+
+    const DATA_URL = 'data/growth_metadata.json';
+    const REFRESH_MS = 60000;
+    const WIB_MS = 7 * 3600 * 1000;
+
+    // Empat kelas CNN. `ord` = urutan tahap tumbuh (dipakai LSTM); bukan_selada tidak ikut deret.
+    const CLASSES = {
+        masa_pertumbuhan: { label: 'Masa Pertumbuhan', ord: 0, tone: 'info' },
+        mendekati_panen: { label: 'Mendekati Panen', ord: 1, tone: 'warn' },
+        siap_panen: { label: 'Siap Panen', ord: 2, tone: 'ok' },
+        bukan_selada: { label: 'Bukan Selada', ord: null, tone: 'err' }
+    };
+
+    function normClass(v) {
+        if (v === null || v === undefined) return null;
+        const k = String(v).trim().toLowerCase().replace(/[\s-]+/g, '_');
+        return Object.prototype.hasOwnProperty.call(CLASSES, k) ? k : null;
+    }
+
+    /** Hanya URL http(s) atau path relatif situs ini; selain itu dibuang. */
+    function safeUrl(u) {
+        if (typeof u !== 'string') return '';
+        const s = u.trim();
+        if (!s) return '';
+        if (/^https?:\/\//i.test(s)) return s;
+        if (/^(\.\/|data\/|\/(?!\/))/.test(s)) return s;
+        return '';
+    }
+
+    function wibDayKey(t) {
+        return new Date(t + WIB_MS).toISOString().slice(0, 10);
+    }
+
+    class GrowthStore {
+        constructor() {
+            this.records = []; // urut naik menurut waktu
+            this.listeners = [];
+            this.sig = '';
+            this.loaded = false;
+        }
+
+        onChange(fn) {
+            if (typeof fn === 'function') this.listeners.push(fn);
+        }
+
+        normalize(raw) {
+            if (!raw || typeof raw !== 'object') return null;
+            const t = Number(raw.captured_at);
+            if (!Number.isFinite(t) || t < 1e11) return null;
+            const width = Number(raw.leaf_width_px);
+            const conf = Number(raw.cnn_confidence);
+            return {
+                id: String(raw.image_id || ('img_' + t)),
+                t: t,
+                hst: Number(raw.hst_day) > 0 ? Number(raw.hst_day) : null,
+                width: Number.isFinite(width) && width > 0 ? width : null,
+                valid: String(raw.quality_status || '').toUpperCase() === 'VALID',
+                cls: normClass(raw.cnn_class !== undefined ? raw.cnn_class : raw.stage),
+                conf: Number.isFinite(conf) ? Math.max(0, Math.min(1, conf)) : null,
+                image: safeUrl(raw.image_url),
+                mask: safeUrl(raw.mask_url),
+                overlay: safeUrl(raw.overlay_url)
+            };
+        }
+
+        async load() {
+            try {
+                const resp = await fetch(DATA_URL, { cache: 'no-store' });
+                if (!resp.ok) throw new Error('HTTP ' + resp.status);
+                const data = await resp.json();
+                const rows = (Array.isArray(data) ? data : [])
+                    .map(r => this.normalize(r))
+                    .filter(Boolean)
+                    .sort((a, b) => a.t - b.t);
+                const last = rows[rows.length - 1];
+                const sig = rows.length + ':' + (last ? last.t + ':' + last.cls + ':' + last.width : '');
+                if (!this.loaded || sig !== this.sig) {
+                    this.records = rows;
+                    this.sig = sig;
+                    this.loaded = true;
+                    this.listeners.forEach(fn => {
+                        try { fn(this); } catch (e) { console.error('[GrowthStore] listener error:', e); }
+                    });
+                }
+            } catch (err) {
+                console.warn('[GrowthStore] gagal memuat ' + DATA_URL + ':', err);
+            }
+        }
+
+        start() {
+            this.load();
+            setInterval(() => this.load(), REFRESH_MS);
+        }
+
+        /** Citra lolos QC (valid). */
+        validRecords() { return this.records.filter(r => r.valid); }
+
+        /** Citra valid yang benar-benar selada dan punya lebar daun. */
+        lettuceRecords() {
+            return this.records.filter(r => r.valid && r.cls !== 'bukan_selada' && r.width !== null);
+        }
+
+        latest() {
+            const v = this.validRecords();
+            return v.length ? v[v.length - 1] : null;
+        }
+
+        classCounts() {
+            const c = { masa_pertumbuhan: 0, mendekati_panen: 0, siap_panen: 0, bukan_selada: 0, belum: 0 };
+            this.validRecords().forEach(r => { c[r.cls || 'belum']++; });
+            return c;
+        }
+
+        hasClassified() {
+            return this.validRecords().some(r => r.cls !== null);
+        }
+
+        /** Rata-rata lebar daun per hari (WIB) + kelas dominan CNN hari itu. */
+        daily() {
+            const days = new Map();
+            this.lettuceRecords().forEach(r => {
+                const k = wibDayKey(r.t);
+                if (!days.has(k)) days.set(k, { sum: 0, n: 0, cls: {} });
+                const d = days.get(k);
+                d.sum += r.width;
+                d.n++;
+                if (r.cls && CLASSES[r.cls].ord !== null) d.cls[r.cls] = (d.cls[r.cls] || 0) + 1;
+            });
+            return Array.from(days.keys()).sort().map(k => {
+                const d = days.get(k);
+                const top = Object.keys(d.cls).sort((a, b) => d.cls[b] - d.cls[a])[0];
+                return {
+                    day: k,
+                    t: Date.parse(k + 'T00:00:00Z'),
+                    width: d.sum / d.n,
+                    stage: top ? CLASSES[top].ord : null,
+                    n: d.n
+                };
+            });
+        }
+    }
+
+    const store = new GrowthStore();
+    store.CLASSES = CLASSES;
+    store.safeUrl = safeUrl;
+    window.GrowthStore = store;
+})(window);
