-        // ================= STATISTICAL AGGREGATION & METRICS =================
-        getCampaignStats() {
-            const total = this.records.length;
-            const valid = this.records.filter(r => r.quality_status === 'VALID').length;
-            const failed = total - valid;
-            const target = CAMPAIGN_SPEC.targetValidImages;
-            const targetPct = Math.min(100, Math.round((valid / target) * 100));
-            const daysRemaining = Math.max(0, CAMPAIGN_SPEC.totalDays - this.currentHST);
-
-            const latestValid = this.records.find(r => r.quality_status === 'VALID') || null;
-
-            let dailyGrowthRatePx = 0;
-            const validAsc = this.records.filter(r => r.quality_status === 'VALID').sort((a, b) => a.captured_at - b.captured_at);
-            if (validAsc.length >= 2) {
-                const recent = validAsc[validAsc.length - 1];
-                const earlier = validAsc[Math.max(0, validAsc.length - 6)];
-                const daysDiff = Math.max(0.5, (recent.captured_at - earlier.captured_at) / 86400000);
-                dailyGrowthRatePx = Math.round(((recent.leaf_width_px - earlier.leaf_width_px) / daysDiff) * 10) / 10;
-            }
-
-            return {
-                totalCaptured: total,
-                validCount: valid,
-                failedCount: failed,
-                targetValid: target,
-                targetPct: targetPct,
-                totalSlots: CAMPAIGN_SPEC.totalSlots,
-                currentHST: this.currentHST,
-                totalDays: CAMPAIGN_SPEC.totalDays,
-                daysRemaining: daysRemaining,
-                latestRecord: latestValid,
-                dailyGrowthRatePx: Math.max(0, dailyGrowthRatePx),
-                dailyGrowthRateMm: this.calibRatio ? Math.round(dailyGrowthRatePx * this.calibRatio * 10) / 10 : null,
-                calibrated: this.calibRatio !== null
-            };
-        }
